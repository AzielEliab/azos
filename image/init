#!/bin/busybox sh
# AZOS-BOOT-1 init (PID 1). Minimal: proves the boot path only. Not the AZ-OS Python userspace yet.
# No guardian runs in this image yet (capability 4, not built), so it reports guardian: absent honestly.
# Host bash and SSH are OFF; this image ships neither; no shell reachable from init.
# Link only the applets init needs (no sh, ash, getty, login, telnetd...).
for a in mount uname cat sha256sum cut poweroff; do /bin/busybox ln -s busybox /bin/$a; done
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
echo "AZOS guardian: absent (not built in this image; no refusal gate runs yet)"
echo "AZOS bash_host: OFF  ssh: OFF  vpn: OFF  hypervisor: OFF (not built; off until verified)"
KREL=$(uname -r)
IMG=$(cat /etc/azos-image-sha256 2>/dev/null || echo unknown)
BODY="{\"author\":\"Aziel Eliab\",\"guardian\":\"absent\",\"image_sha256\":\"$IMG\",\"kernel\":\"$KREL\",\"kind\":\"azos.boot\",\"signed\":false,\"spec\":\"AZOS-BOOT-1\",\"where\":\"qemu\"}"
H=$(printf '%s' "$BODY" | sha256sum | cut -d' ' -f1)
echo "AZOS-BOOT-1 sealed=$H $BODY"
poweroff -f
